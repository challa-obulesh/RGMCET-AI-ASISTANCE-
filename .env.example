# MongoDB is optional for local development. Empty uses in-memory demo data.
MONGODB_URI=
DATABASE_NAME=rgmcet_ai
DEMO_MODE=true

# Hosted LLM providers (backend only). The selected provider is preferred;
# another provider with a key is used as a fallback. Empty keys use local fallback.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend only; set in frontend/.env.local if the API URL differs.
VITE_API_BASE_URL=http://localhost:8000/api