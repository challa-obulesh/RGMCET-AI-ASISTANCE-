# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to GitHub.

# ---- Web MVP LLM provider (server-side only, never exposed to frontend) ----
LLM_PROVIDER=gemini

# ---- Gemini (preferred) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- OpenAI (alternative) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- MongoDB ----
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
DATABASE_NAME=rgmcet_ai_assistant

# ---- JWT Authentication (server-side only) ----
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# ---- CORS (comma-separated frontend origins) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173